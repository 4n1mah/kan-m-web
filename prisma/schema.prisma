generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  imageUrl    String   @map("image_url")
  price       Float?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
  @@index([category])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NEEDS_INFO
  REJECTED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  name          String
  phone         String
  email         String?
  eventType     String      @map("event_type")
  eventDate     String      @map("event_date")
  guestCount    String      @map("guest_count")
  selectedItems Json        @map("selected_items")
  cakeDetails   Json?       @map("cake_details")
  notes         String?
  imageUrls     Json        @map("image_urls")
  deliveryTime  String?     @map("delivery_time")
  status        OrderStatus @default(PENDING)
  assignedTo    String?     @map("assigned_to")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("orders")
  @@index([status])
  @@index([createdAt])
}
