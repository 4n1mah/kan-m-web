generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  OWNER     // Acceso total: usuarios, configuración, todo
  BAKER     // Reposteras: pedidos y catálogo, sin gestión de usuarios
  ASSISTANT // Empleados: pedidos asignados, lectura de catálogo
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  role                UserRole  @default(BAKER)
  active              Boolean   @default(true)
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  // Token FCM del último dispositivo móvil que registró este usuario.
  // Asumimos un dispositivo activo por usuario; si en el futuro hay más
  // dispositivos, migrar a una tabla FcmDevice.
  fcmToken            String?   @map("fcm_token")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  activities   ActivityLog[]

  @@map("users")
  @@index([email])
}

// Bitácora de cambios — un registro por cada acción importante.
// Permite responder "¿quién cambió qué y cuándo?" para pedidos, productos,
// y usuarios sin meter todo dentro del JSON del recurso.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")  // null si fue acción del sistema
  userName   String   @map("user_name") // copia denormalizada por si el user se borra
  action     String   // "order.create", "order.status", "product.update", etc.
  entityType String   @map("entity_type") // "order" | "product" | "user"
  entityId   String   @map("entity_id")
  metadata   Json?    // cambios detallados, ej: { from: "PENDING", to: "CONFIRMED" }
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_log")
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

enum ProductAvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

model Product {
  id                 String                    @id @default(cuid())
  name               String
  description        String
  category           String
  imageUrl           String                    @map("image_url")
  price              Float?
  availabilityStatus ProductAvailabilityStatus @default(AVAILABLE) @map("availability_status")
  createdAt          DateTime                  @default(now()) @map("created_at")

  @@map("products")
  @@index([category])
  @@index([availabilityStatus])
}

// Cómo entró el pedido: desde la web pública o tomado en persona
// en la repostería por una repostera/admin logueada.
enum OrderSource {
  ONLINE
  IN_PERSON
}

enum OrderStatus {
  PENDING
  CONFIRMED
  NEEDS_INFO
  COMPLETED
  DELIVERED
  REJECTED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  name          String
  phone         String
  email         String?
  eventType     String      @map("event_type")
  eventDate     String      @map("event_date")
  guestCount    String      @map("guest_count")
  selectedItems Json        @map("selected_items")
  cakeDetails   Json?       @map("cake_details")
  notes         String?
  internalNote  String?     @map("internal_note")
  imageUrls     Json        @map("image_urls")
  deliveryTime  String?     @map("delivery_time")
  status        OrderStatus @default(PENDING)
  assignedTo    String?     @map("assigned_to")
  agreedPrice   Float?      @map("agreed_price")
  depositAmount Float?      @map("deposit_amount")
  paymentStatus String      @default("PENDING") @map("payment_status") // PENDING | PARTIAL | PAID
  deliveryMethod String?    @map("delivery_method") // "pickup" | "delivery"
  source        OrderSource @default(ONLINE) // ONLINE = web pública, IN_PERSON = agendado en tienda
  takenBy       String?     @map("taken_by") // nombre del usuario que lo agendó en persona
  statusLog     Json        @default("[]") @map("status_log")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("orders")
  @@index([status])
  @@index([createdAt])
}

// ── Cart Orders ───────────────────────────────────────────────
// Órdenes generadas desde el carrito del catálogo público.
// Separadas del modelo Order (cotizaciones) para no mezclar flujos.

enum CartOrderStatus {
  PENDING
  CONFIRMED
  DENIED
  SENT
}

enum FulfillmentMethod {
  DINE_IN
  PICKUP
}

enum ExternalSyncStatus {
  NOT_SENT
  SENT
  FAILED
}

model CartOrder {
  id                 String             @id @default(cuid())
  code               String             @unique  // PED-XXXX
  customerName       String             @map("customer_name")
  customerPhone      String             @map("customer_phone")
  fulfillmentMethod  FulfillmentMethod  @map("fulfillment_method")
  items              Json               // snapshot: [{ id, name, price, quantity, category }]
  subtotal           Float
  total              Float
  receiptImageUrl    String             @map("receipt_image_url")
  status             CartOrderStatus    @default(PENDING)
  externalSyncStatus ExternalSyncStatus @default(NOT_SENT) @map("external_sync_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("cart_orders")
  @@index([status])
  @@index([createdAt])
}

// ── Tablas del BOT de WhatsApp (proyecto Python/FastAPI externo) ──────────
// El bot vive en otro repo pero comparte esta misma base de datos Neon.
// Estas tablas las crea y administra ÉL — están aquí solo para que
// `prisma db push` no intente borrarlas. NO usarlas desde Next.js y NO
// modificarlas aquí: cualquier cambio de estructura se hace en el bot.

model wa_conversations {
  phone            String    @id
  name             String?
  state            String    @default("nuevo")
  context          Json?     @default("{}")
  fallback_count   Int?      @default(0)
  escalated_at     DateTime? @db.Timestamptz(6)
  last_inbound_at  DateTime? @db.Timestamptz(6)
  last_outbound_at DateTime? @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
}

model wa_processed_messages {
  message_id String    @id
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_wa_processed_messages_created_at")
}

/// Tabla de diagnóstico del bot — sin id único, Prisma la ignora.
model wa_test_diag {
  id Int?

  @@ignore
}

model WhatsappEscalation {
  id          String    @id @default(cuid())
  phone       String    @unique
  clientName  String    @map("client_name")
  motivo      String
  summary     String    @db.Text
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_escalations")
  @@index([resolvedAt])
  @@index([createdAt])
}
