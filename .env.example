# ────────────────────────────────────────────────────────────────
#  KAN M — Variables de entorno
#  Copia este archivo como `.env.local` (desarrollo) o configura
#  las mismas variables en Vercel → Settings → Environment Variables
#  para producción. NUNCA pongas valores reales en este archivo.
# ────────────────────────────────────────────────────────────────

# ── Base de datos ──
# Neon Postgres — usar cadena "pooled" para queries normales.
DATABASE_URL=""
# Cadena "direct" (sin pooler) — la pide Prisma para migrations.
DATABASE_URL_UNPOOLED=""

# ── JWT (sesión del admin) ──
# Generar con: openssl rand -base64 32 (o `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`)
# DEBE ser ≥ 32 caracteres aleatorios. Si rotas este valor, todos los admins
# logueados serán deslogueados (intencional/saludable).
AUTH_SECRET="generar-con-openssl-rand-base64-32"

# ── Cloudinary (almacenamiento de imágenes) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Configuración pública ──
# Visibles en el cliente (NEXT_PUBLIC_*). No poner secretos aquí.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_SITE_URL=""

# ── API externa opcional (sync de órdenes online) ──
# Si la dejas vacía, el sync queda como NOT_SENT y no rompe nada.
# EXTERNAL_ORDERS_API_URL=""

# ── Rate limiter distribuido (Upstash Redis) ──
# Si están vacías, el rate limiter cae al modo en memoria (best effort,
# por instancia serverless). Para producción a escala, llena ambas.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Bot externo de WhatsApp ──
# Clave compartida con el proyecto Python/FastAPI que opera el bot. La
# manda como header `x-bot-api-key` al POST /api/whatsapp/escalations.
# Si está vacía, el endpoint responde 503 (deshabilitado a propósito).
# Generar con: openssl rand -base64 32
BOT_API_KEY=""

# ── Notificaciones push (Firebase Cloud Messaging) ──
# Contenido COMPLETO del JSON de service account (Firebase Console →
# Project Settings → Service accounts → Generate new private key).
# Si está vacía, las notificaciones push quedan deshabilitadas (no-op).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ── Push web en el panel admin (config PÚBLICA de Firebase) ──
# Necesarias para que las notificaciones lleguen al celular aunque Chrome
# esté cerrado. Valores en Firebase Console → Project settings → General →
# Your apps → Web app (crear una si no existe). La VAPID key está en
# Project settings → Cloud Messaging → Web Push certificates → Generate key pair.
# Si falta alguna, el panel simplemente no ofrece activar notificaciones.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── Cron de escalaciones (auto-resolver por inactividad) ──
# Requerido: sin este valor, GET /api/whatsapp/escalations/cron responde 503.
# Vercel lo manda automáticamente como `Authorization: Bearer <CRON_SECRET>`
# si defines la variable en el proyecto. Generar con: openssl rand -base64 32
CRON_SECRET=""
