# ────────────────────────────────────────────────────────────────
#  KAN M — Variables de entorno
#  Copia este archivo como `.env.local` (desarrollo) o configura
#  las mismas variables en Vercel → Settings → Environment Variables
#  para producción. NUNCA pongas valores reales en este archivo.
# ────────────────────────────────────────────────────────────────

# ── Base de datos ──
# Neon Postgres — usar cadena "pooled" para queries normales.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Cadena "direct" (sin pooler) — la pide Prisma para migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ── JWT (sesión del admin) ──
# Generar con: openssl rand -base64 32 (o `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`)
# DEBE ser ≥ 32 caracteres aleatorios. Si rotas este valor, todos los admins
# logueados serán deslogueados (intencional/saludable).
AUTH_SECRET="generar-con-openssl-rand-base64-32"

# ── Cloudinary (almacenamiento de imágenes) ──
CLOUDINARY_CLOUD_NAME="dsvcag6oo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Configuración pública ──
# Visibles en el cliente (NEXT_PUBLIC_*). No poner secretos aquí.
NEXT_PUBLIC_WHATSAPP_NUMBER="18296107064"
NEXT_PUBLIC_SITE_URL="https://kan-m-reposteria.vercel.app"

# ── API externa opcional (sync de órdenes online) ──
# Si la dejas vacía, el sync queda como NOT_SENT y no rompe nada.
# EXTERNAL_ORDERS_API_URL=""

# ── Rate limiter distribuido (Upstash Redis) ──
# Si están vacías, el rate limiter cae al modo en memoria (best effort,
# por instancia serverless). Para producción a escala, llena ambas.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
