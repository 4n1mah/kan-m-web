generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // "cakes" | "desserts" | "events"
  imageUrl    String   @map("image_url")
  price       Float?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
  @@index([category])
}
